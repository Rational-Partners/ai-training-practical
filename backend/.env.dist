# backend/.env.dist - copy to .env and customise for your local environment

# Prisma Database Connection (SQLite)
DATABASE_URL="file:./dev.db"

# Backend Server Port
BACKEND_PORT=5001

# Frontend URL for CORS (comma-separated list of allowed origins)
# Uncomment and set to your frontend URL if it differs from the default
# FRONTEND_URL=http://localhost:5173
